@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix cpm:  <https://www.commonprovenancemodel.org/cpm#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Shapes are open (no sh:closed). ISO/DIS 23494-2 §4.3.2 writes every CPM
# structure as [prov:type=..., ...], and §4.3.3 lets the CPM attributes be
# used on any PROV entity, activity or agent. Only what the standard
# requires is enforced; any other attribute is allowed.

# ========================# §4.3.4.3: cpm:hashValue shall always be used with cpm:hashAlg. The "should"
# part (every digital object has a hash) is not checked: a validator cannot
# tell a digital object from a physical one.=============================================
# CPM attributes
# Justified by: ISO/DIS 23494-2 §4.3.3. Value checks apply to every node
# that uses an attribute, not only to the eight CPM structures.
# =====================================================================

cpm:AttributeShape a sh:NodeShape ;
    rdfs:label "Shape for CPM Attributes"@en ;
    rdfs:comment "Validates the value of each CPM attribute wherever it is used."@en ;
    sh:targetSubjectsOf cpm:externalId, cpm:externalIdType, cpm:hasId, cpm:describedObjectType,
        cpm:comment, cpm:referencedBundleId, cpm:referencedMetaBundleId, cpm:referencedBundleSpecV,
        cpm:referencedMetaBundleSpecV, cpm:provenanceServiceUri, cpm:hashValue,
        cpm:referencedBundleHashValue, cpm:hashAlg, cpm:contactIdPid ;

    sh:property [ sh:path cpm:externalId ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path cpm:externalIdType ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path cpm:hasId ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ;
    sh:property [ sh:path cpm:describedObjectType ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path cpm:comment ; sh:datatype xsd:string ] ;
    sh:property [ sh:path cpm:referencedBundleId ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ;
    sh:property [ sh:path cpm:referencedMetaBundleId ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ;
    sh:property [ sh:path cpm:referencedBundleSpecV ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path cpm:referencedMetaBundleSpecV ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path cpm:provenanceServiceUri ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ;
    sh:property [ sh:path cpm:hashValue ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path cpm:referencedBundleHashValue ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path cpm:hashAlg ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path cpm:contactIdPid ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] .

# =====================================================================
# Backward Connector
# Justified by: CPF Supplementary §1.2 (Figures 4, 6, 7), ISO/DIS 23494-2 §4.3.2
# =====================================================================

cpm:BackwardConnectorShape a sh:NodeShape ;
    rdfs:label "Shape for Backward Connector"@en ;
    rdfs:comment "Validation shape for cpm:BackwardConnector (per CPF Supplementary §1.2)."@en ;
    sh:targetClass cpm:BackwardConnector ;

    sh:property [
        sh:path prov:type ;
        sh:hasValue cpm:backwardConnector ;
        sh:minCount 1 ;
        sh:message "A backward connector MUST have at least one prov:type attribute set to cpm:backwardConnector."@en ;
    ] ;

    sh:property [
        sh:path cpm:referencedBundleId ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A backward connector MUST have exactly one cpm:referencedBundleId attribute of type IRI."@en ;
    ] ;

    sh:property [
        sh:path cpm:referencedMetaBundleId ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A backward connector MUST have exactly one cpm:referencedMetaBundleId attribute of type IRI."@en ;
    ] ;

    sh:property [
        sh:path cpm:referencedBundleSpecV ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A backward connector MUST have exactly one cpm:referencedBundleSpecV attribute."@en ;
    ] ;

    sh:property [
        sh:path cpm:referencedMetaBundleSpecV ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A backward connector MUST have exactly one cpm:referencedMetaBundleSpecV attribute."@en ;
    ] ;

    sh:property [
        sh:path cpm:referencedBundleHashValue ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A backward connector MUST have exactly one cpm:referencedBundleHashValue attribute."@en ;
    ] ;

    sh:property [
        sh:path cpm:hashAlg ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A backward connector MUST have exactly one cpm:hashAlg attribute."@en ;
    ] ;

    sh:property [
        sh:path prov:wasDerivedFrom ;
        sh:nodeKind sh:IRI ;
        sh:message "Optional: backward connector MAY be derived from another connector (redundant connector pattern, CPF Supplementary §1.2.2 Figure 6)."@en ;
    ] .

# =====================================================================
# Forward Connector
# Justified by: CPF Supplementary §1.2 (Figures 4, 5), ISO/DIS 23494-2 §4.3.2
# =====================================================================

cpm:ForwardConnectorShape a sh:NodeShape ;
    rdfs:label "Shape for Forward Connector"@en ;
    rdfs:comment "Validation shape for cpm:ForwardConnector (per CPF Supplementary §1.2)."@en ;
    sh:targetClass cpm:ForwardConnector ;

    sh:property [
        sh:path prov:type ;
        sh:hasValue cpm:forwardConnector ;
        sh:minCount 1 ;
        sh:message "A forward connector MUST have at least one prov:type attribute set to cpm:forwardConnector."@en ;
    ] ;

    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "A forward connector MUST be generated by a main activity (CPF Supplementary §1.2)."@en ;
    ] ;

    sh:property [
        sh:path prov:wasDerivedFrom ;
        sh:nodeKind sh:IRI ;
        sh:message "Optional: forward connector MAY be derived from a backward connector (within-FPC lineage)."@en ;
    ] ;

    sh:property [
        sh:path prov:specializationOf ;
        sh:nodeKind sh:IRI ;
        sh:message "Optional on plain forward connector; required on ForwardConnectorSpecialized."@en ;
    ] .

# =====================================================================
# Specialized Forward Connector
# Justified by: CPF Supplementary §1.2 (Figure 5), ISO/DIS 23494-2 §4.3.2
# =====================================================================

cpm:ForwardConnectorSpecializedShape a sh:NodeShape ;
    rdfs:label "Shape for Specialized Forward Connector"@en ;
    rdfs:comment "Validation shape for cpm:ForwardConnectorSpecialized (per CPF Supplementary §1.2 Figure 5)."@en ;
    sh:targetClass cpm:ForwardConnectorSpecialized ;

    sh:property [
        sh:path prov:type ;
        sh:hasValue cpm:specForwardConnector ;
        sh:minCount 1 ;
        sh:message "A specialized forward connector MUST have prov:type cpm:specForwardConnector."@en ;
    ] ;

    sh:property [
        sh:path prov:specializationOf ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "A specialized forward connector MUST be a prov:specializationOf an existing forward connector (CPF Supplementary §1.2 Figure 5)."@en ;
    ] ;

    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "A specialized forward connector MUST be generated by a main activity."@en ;
    ] ;

    sh:property [
        sh:path prov:wasDerivedFrom ;
        sh:nodeKind sh:IRI ;
        sh:message "Optional: FCS MAY be derived from a backward connector."@en ;
    ] ;

    sh:property [
        sh:path cpm:referencedBundleId ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "FCS MUST have exactly one cpm:referencedBundleId."@en ;
    ] ;
    sh:property [
        sh:path cpm:referencedMetaBundleId ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "FCS MUST have exactly one cpm:referencedMetaBundleId."@en ;
    ] ;
    sh:property [
        sh:path cpm:referencedBundleSpecV ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path cpm:referencedMetaBundleSpecV ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path cpm:hashAlg ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path cpm:referencedBundleHashValue ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
    ] .

# =====================================================================
# Identifier Entity
# Justified by: CPF Supplementary §1.1 (Figure 1), ISO/DIS 23494-2 §4.3.2
# =====================================================================

cpm:IdentifierEntityShape a sh:NodeShape ;
    rdfs:label "Shape for Identifier Entity"@en ;
    sh:targetClass cpm:IdentifierEntity ;

    sh:property [
        sh:path prov:type ; sh:hasValue cpm:id ; sh:minCount 1 ;
        sh:message "An identifier entity MUST have prov:type cpm:id."@en ;
    ] ;
    sh:property [
        sh:path cpm:externalId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path cpm:externalIdType ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path prov:alternateOf ;
        sh:nodeKind sh:IRI ;
        sh:message "Optional: identifier entity MAY be prov:alternateOf the described object."@en ;
    ] .

# =====================================================================
# Main Activity
# Justified by: CPF Supplementary §1.2 (exactly one per FPC; generates
# at least one forward connector; uses backward connectors when present),
# ISO/DIS 23494-2 §4.3.2
# =====================================================================

cpm:MainActivityShape a sh:NodeShape ;
    rdfs:label "Shape for Main Activity"@en ;
    sh:targetClass cpm:MainActivity ;

    sh:property [
        sh:path prov:type ; sh:hasValue cpm:mainActivity ; sh:minCount 1 ;
        sh:message "A main activity MUST have prov:type cpm:mainActivity."@en ;
    ] ;
    sh:property [
        sh:path cpm:referencedMetaBundleId ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A main activity MUST have exactly one cpm:referencedMetaBundleId."@en ;
    ] ;
    sh:property [
        sh:path cpm:referencedMetaBundleSpecV ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
    ] ;

    # startTime / endTime: optional properties (ISO/DIS 23494-2 §4.3.2).
    # dct:hasPart is also optional there and needs no rule in an open shape.
    sh:property [
        sh:path prov:startedAtTime ; sh:datatype xsd:dateTime ; sh:maxCount 1 ;
        sh:message "A main activity MAY have one prov:startedAtTime of type xsd:dateTime."@en ;
    ] ;
    sh:property [
        sh:path prov:endedAtTime ; sh:datatype xsd:dateTime ; sh:maxCount 1 ;
        sh:message "A main activity MAY have one prov:endedAtTime of type xsd:dateTime."@en ;
    ] ;

    sh:property [
        sh:path prov:wasAssociatedWith ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "A main activity MUST be associated with at least one prov:Agent (CPF Supplementary §1.2 Figures 4-7)."@en ;
    ] ;
    sh:property [
        sh:path prov:used ;
        sh:nodeKind sh:IRI ;
        sh:message "A main activity MAY use backward connectors. Absence indicates the start of a chain (CPF Supplementary §1.2 line 110-112)."@en ;
    ] .

# =====================================================================
# Sender Agent
# Justified by: ISO/DIS 23494-2 §4.3.2
# =====================================================================

cpm:SenderAgentShape a sh:NodeShape ;
    sh:targetClass cpm:SenderAgent ;

    sh:property [
        sh:path prov:type ; sh:hasValue cpm:senderAgent ; sh:minCount 1 ;
        sh:message "A sender agent MUST have prov:type cpm:senderAgent."@en ;
    ] ;
    sh:property [
        sh:path cpm:contactIdPid ; sh:nodeKind sh:IRI ; sh:minCount 1 ;
        sh:message "A sender agent MUST have a cpm:contactIdPid of type IRI."@en ;
    ] .

# =====================================================================
# Receiver Agent
# Justified by: ISO/DIS 23494-2 §4.3.2
# =====================================================================

cpm:ReceiverAgentShape a sh:NodeShape ;
    sh:targetClass cpm:ReceiverAgent ;

    sh:property [
        sh:path prov:type ; sh:hasValue cpm:receiverAgent ; sh:minCount 1 ;
        sh:message "A receiver agent MUST have prov:type cpm:receiverAgent."@en ;
    ] ;
    sh:property [
        sh:path cpm:contactIdPid ; sh:nodeKind sh:IRI ; sh:minCount 1 ;
        sh:message "A receiver agent MUST have a cpm:contactIdPid of type IRI."@en ;
    ] .

# =====================================================================
# Current Agent
# Justified by: ISO/DIS 23494-2 §4.3.2
# =====================================================================

cpm:CurrentAgentShape a sh:NodeShape ;
    sh:targetClass cpm:CurrentAgent ;

    sh:property [
        sh:path prov:type ; sh:hasValue cpm:currentAgent ; sh:minCount 1 ;
        sh:message "A current agent MUST have prov:type cpm:currentAgent."@en ;
    ] ;
    sh:property [
        sh:path cpm:contactIdPid ; sh:nodeKind sh:IRI ; sh:minCount 1 ;
        sh:message "A current agent MUST have a cpm:contactIdPid of type IRI."@en ;
    ] .

# =====================================================================
# Requirements on the CPM structures
# Justified by: ISO/DIS 23494-2 §4.3.4. §4.3.4.1 (mandatory attributes
# have values) is already covered by the minCount rules above.
# =====================================================================

# §4.3.4.2: a specification version that names an ISO document uses the
# format ISO-[DOC_TYPE]-[PROJECT-CODE]-[PART]:[YEAR-OF-PUBLICATION].
# A value counts as naming an ISO document when it starts with "ISO" (any
# case); other values, e.g. "1.0", are not constrained by the standard.
cpm:SpecVersionFormatShape a sh:NodeShape ;
    rdfs:label "Shape for CPM Specification Version Format"@en ;
    sh:targetSubjectsOf cpm:referencedBundleSpecV, cpm:referencedMetaBundleSpecV ;

    sh:property [
        sh:path [ sh:alternativePath ( cpm:referencedBundleSpecV cpm:referencedMetaBundleSpecV ) ] ;
        sh:or (
            [ sh:not [ sh:pattern "^iso" ; sh:flags "i" ] ]
            [ sh:pattern "^ISO-(IS|TS|PAS)-[0-9]+-[0-9]+:[0-9]{4}$" ]
        ) ;
        sh:message "A specification version naming an ISO document MUST have the format ISO-[DOC_TYPE]-[PROJECT-CODE]-[PART]:[YEAR-OF-PUBLICATION] with DOC_TYPE IS, TS or PAS, e.g. ISO-IS-23494-2:2026 (ISO/DIS 23494-2 §4.3.4.2)."@en ;
    ] .

# §4.3.4.3: cpm:hashValue shall always be used with cpm:hashAlg. The "should"
# part (every digital object has a hash) is not checked: a validator cannot
# tell a digital object from a physical one.
cpm:HashValueShape a sh:NodeShape ;
    rdfs:label "Shape for Hash Values"@en ;
    sh:targetSubjectsOf cpm:hashValue ;

    sh:property [
        sh:path cpm:hashAlg ; sh:minCount 1 ;
        sh:message "cpm:hashValue MUST be used together with cpm:hashAlg (ISO/DIS 23494-2 §4.3.4.3)."@en ;
    ] .
