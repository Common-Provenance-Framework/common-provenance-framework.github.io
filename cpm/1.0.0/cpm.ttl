@prefix : <https://www.commonprovenancemodel.org/cpm#> .
@prefix cpm: <https://www.commonprovenancemodel.org/cpm#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@base <https://www.commonprovenancemodel.org/cpm#> .

<https://www.commonprovenancemodel.org/cpm#> rdf:type owl:Ontology ;
                                              owl:versionIRI <https://www.commonprovenancemodel.org/cpm/1.0.0> ;
                                              owl:imports <http://www.w3.org/ns/prov-o-20130430> ;
                                              dct:abstract "The Common Provenance Model Ontology (CPM-O) expresses the Common Provenance Model (CPM) [REF] using the OWL2 Web Ontology Language (OWL2) [OWL2-OVERVIEW]. It provides a set of classes and properties that can be used to represent and interchange provenance information generated by different organizations in different systems and under different contexts. It can also be specialized to create new classes and properties to model provenance information for different applications and domains. CPM-O and CPM are part of the Common Provenance Framework (CPF). CPM-O is an extension of PROV-O. CPM-O is standardized as ISO 23494-2 Common Provenance Model for Biological Material and Data."@en ;
                                              dct:contributor "Rudolf Wittner" ,
                                                              "Cecilia Mascia" ,
                                                              "Francesca Frexia" ,
                                                              "Heimo Müller" ,
                                                              "Jörg Geiger" ,
                                                              "Markus Plass" ,
                                                              "Matej Gallo" ,
                                                              "Petr Holub" ;
                                              dct:created "2026-02-05"^^xsd:date ;
                                              dct:description "Each CPM type value (e.g. cpm:backwardConnector) is declared as a class equivalent to the corresponding CPM-O class (e.g. cpm:BackwardConnector), so RDF produced from PROV-N/PROV-JSON by standard PROV tooling is classified correctly. The implementations should use the capitalized class names."@en ;
                                              dct:license <http://creativecommons.org/licenses/by/4.0/> ;
                                              dct:title "Common Provenance Model Ontology (CPM-O)"@en ;
                                              vann:preferredNamespacePrefix "cpm" ;
                                              vann:preferredNamespaceUri "https://www.commonprovenancemodel.org/cpm#" ;
                                              rdfs:seeAlso <https://doi.org/10.5281/zenodo.19889324> ,
                                                           <https://github.com/Common-Provenance-Framework> ,
                                                           <https://www.commonprovenancemodel.org/PLACEHOLDER-known-issues> ;
                                              owl:versionInfo "1.0.0"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/abstract
dct:abstract rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/contributor
dct:contributor rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
dct:created rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
dct:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
dct:license rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dct:title rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
vann:preferredNamespaceUri rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/usageNote
vann:usageNote rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Data properties
#################################################################

###  https://www.commonprovenancemodel.org/cpm#comment
cpm:comment rdf:type owl:DatatypeProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( prov:Activity
                                        prov:Agent
                                        prov:Entity
                                      )
                        ] ;
            rdfs:range [ rdf:type rdfs:Datatype ;
                         owl:unionOf ( rdf:langString
                                       xsd:string
                                     )
                       ] ;
            rdfs:comment "arbitrary comment or additional information."@en ;
            rdfs:isDefinedBy <https://www.commonprovenancemodel.org/cpm#> ;
            rdfs:label "comment"@en .


###  https://www.commonprovenancemodel.org/cpm#contactIdPid
cpm:contactIdPid rdf:type owl:DatatypeProperty ;
                 rdfs:domain prov:Agent ;
                 rdfs:range xsd:anyURI ;
                 rdfs:comment "a resolvable persistent identifier dereferencing to actual contact information (e.g. email address) that can be used to contact a person or organization represented by a particular agent. The value of this attribute is the full IRI of the persistent identifier, given as a literal of type xsd:anyURI."@en ;
                 rdfs:isDefinedBy <https://www.commonprovenancemodel.org/cpm#> ;
                 rdfs:label "contactIdPid"@en .


###  https://www.commonprovenancemodel.org/cpm#describedObjectType
cpm:describedObjectType rdf:type owl:DatatypeProperty ;
                        rdfs:domain prov:Entity ;
                        rdfs:range xsd:string ;
                        rdfs:comment "type of the object represented by the PROV entity"@en ;
                        rdfs:isDefinedBy <https://www.commonprovenancemodel.org/cpm#> ;
                        rdfs:label "describedObjectType"@en .


###  https://www.commonprovenancemodel.org/cpm#externalId
cpm:externalId rdf:type owl:DatatypeProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( prov:Activity
                                           prov:Agent
                                           prov:Entity
                                         )
                           ] ;
               rdfs:range xsd:string ;
               rdfs:comment "external identifier of a described object or a described activity, which is represented by a PROV entity, PROV activity or PROV agent."@en ;
               rdfs:isDefinedBy <https://www.commonprovenancemodel.org/cpm#> ;
               rdfs:label "externalId"@en .


###  https://www.commonprovenancemodel.org/cpm#externalIdType
cpm:externalIdType rdf:type owl:DatatypeProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( prov:Activity
                                               prov:Agent
                                               prov:Entity
                                             )
                               ] ;
                   rdfs:range xsd:string ;
                   rdfs:comment "type of the external identifier"@en ;
                   rdfs:isDefinedBy <https://www.commonprovenancemodel.org/cpm#> ;
                   rdfs:label "externalIdType"@en .


###  https://www.commonprovenancemodel.org/cpm#hasId
cpm:hasId rdf:type owl:DatatypeProperty ;
          rdfs:domain prov:Entity ;
          rdfs:range xsd:boolean ;
          rdfs:comment "an indication whether the PROV entity having this attribute has an external identifier expressed as a standalone entity"@en ;
          rdfs:isDefinedBy <https://www.commonprovenancemodel.org/cpm#> ;
          rdfs:label "hasId"@en .


###  https://www.commonprovenancemodel.org/cpm#hashAlg
cpm:hashAlg rdf:type owl:DatatypeProperty ;
            rdfs:domain prov:Entity ;
            rdfs:range xsd:string ;
            rdfs:comment "algorithm used to create a hashValue"@en ;
            rdfs:isDefinedBy <https://www.commonprovenancemodel.org/cpm#> ;
            rdfs:label "hashAlg"@en .


###  https://www.commonprovenancemodel.org/cpm#hashValue
cpm:hashValue rdf:type owl:DatatypeProperty ;
              rdfs:domain prov:Entity ;
              rdfs:range xsd:string ;
              vann:usageNote "It is always used together with cpm:hashAlg."@en ;
              rdfs:comment "a hash value of a described object, which is represented by the PROV entity, presuming that the described object is a digital object and not a physical object."@en ;
              rdfs:isDefinedBy <https://www.commonprovenancemodel.org/cpm#> ;
              rdfs:label "hashValue"@en .


###  https://www.commonprovenancemodel.org/cpm#provenanceServiceUri
cpm:provenanceServiceUri rdf:type owl:DatatypeProperty ;
                         rdfs:domain [ rdf:type owl:Class ;
                                       owl:unionOf ( cpm:BackwardConnector
                                                     cpm:ForwardConnectorSpecialized
                                                   )
                                     ] ;
                         rdfs:range xsd:anyURI ;
                         rdfs:comment "URI of a service where a finalized provenance component can be requested using its identifier"@en ;
                         rdfs:isDefinedBy <https://www.commonprovenancemodel.org/cpm#> ;
                         rdfs:label "provenanceServiceUri"@en .


###  https://www.commonprovenancemodel.org/cpm#referencedBundleHashValue
cpm:referencedBundleHashValue rdf:type owl:DatatypeProperty ;
                              rdfs:domain [ rdf:type owl:Class ;
                                            owl:unionOf ( cpm:BackwardConnector
                                                          cpm:ForwardConnectorSpecialized
                                                        )
                                          ] ;
                              rdfs:range xsd:string ;
                              rdfs:comment "a hash value of a provenance component referenced by the connector in which the attribute is present"@en ;
                              rdfs:isDefinedBy <https://www.commonprovenancemodel.org/cpm#> ;
                              rdfs:label "referencedBundleHashValue"@en .


###  https://www.commonprovenancemodel.org/cpm#referencedBundleId
cpm:referencedBundleId rdf:type owl:DatatypeProperty ;
                       rdfs:domain [ rdf:type owl:Class ;
                                     owl:unionOf ( cpm:BackwardConnector
                                                   cpm:ForwardConnectorSpecialized
                                                 )
                                   ] ;
                       rdfs:range xsd:anyURI ;
                       rdfs:comment "identifier of a finalized provenance component referenced by the connector that contains this attribute"@en ;
                       rdfs:isDefinedBy <https://www.commonprovenancemodel.org/cpm#> ;
                       rdfs:label "referencedBundleId"@en .


###  https://www.commonprovenancemodel.org/cpm#referencedBundleSpecV
cpm:referencedBundleSpecV rdf:type owl:DatatypeProperty ;
                          rdfs:domain [ rdf:type owl:Class ;
                                        owl:unionOf ( cpm:BackwardConnector
                                                      cpm:ForwardConnectorSpecialized
                                                    )
                                      ] ;
                          rdfs:range xsd:string ;
                          vann:usageNote "A value specifying an ISO document has the format ISO-[DOC_TYPE]-[PROJECT-CODE]-[PART]:[YEAR-OF-PUBLICATION], where DOC_TYPE is IS, TS or PAS, e.g. ISO-IS-23494-2:2026."@en ;
                          rdfs:comment "specification of the CPM version that is used to represent the content of the referenced finalized provenance component. Used together with the cpm:referencedBundleId attribute."@en ;
                          rdfs:isDefinedBy <https://www.commonprovenancemodel.org/cpm#> ;
                          rdfs:label "referencedBundleSpecV"@en .


###  https://www.commonprovenancemodel.org/cpm#referencedMetaBundleId
cpm:referencedMetaBundleId rdf:type owl:DatatypeProperty ;
                           rdfs:domain [ rdf:type owl:Class ;
                                         owl:unionOf ( cpm:BackwardConnector
                                                       cpm:ForwardConnectorSpecialized
                                                       cpm:MainActivity
                                                     )
                                       ] ;
                           rdfs:range xsd:anyURI ;
                           rdfs:comment "identifier of a meta-component that contains respective finalized provenance component’s metadata"@en ;
                           rdfs:isDefinedBy <https://www.commonprovenancemodel.org/cpm#> ;
                           rdfs:label "referencedMetaBundleId"@en .


###  https://www.commonprovenancemodel.org/cpm#referencedMetaBundleSpecV
cpm:referencedMetaBundleSpecV rdf:type owl:DatatypeProperty ;
                              rdfs:domain [ rdf:type owl:Class ;
                                            owl:unionOf ( cpm:BackwardConnector
                                                          cpm:ForwardConnectorSpecialized
                                                          cpm:MainActivity
                                                        )
                                          ] ;
                              rdfs:range xsd:string ;
                              vann:usageNote "A value specifying an ISO document has the format ISO-[DOC_TYPE]-[PROJECT-CODE]-[PART]:[YEAR-OF-PUBLICATION], where DOC_TYPE is IS, TS or PAS, e.g. ISO-IS-23494-2:2026."@en ;
                              rdfs:comment "specification of the CPM version that is used to represent the content of the referenced meta-component. Used together with the cpm:referencedMetaBundleId attribute."@en ;
                              rdfs:isDefinedBy <https://www.commonprovenancemodel.org/cpm#> ;
                              rdfs:label "referencedMetaBundleSpecV"@en .


#################################################################
#    Classes
#################################################################

###  https://www.commonprovenancemodel.org/cpm#BackwardConnector
cpm:BackwardConnector rdf:type owl:Class ;
                      owl:equivalentClass cpm:backwardConnector ;
                      rdfs:subClassOf prov:Entity ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cpm:hashAlg ;
                                        owl:minCardinality "1"^^xsd:nonNegativeInteger
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cpm:referencedBundleHashValue ;
                                        owl:minCardinality "1"^^xsd:nonNegativeInteger
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cpm:referencedBundleId ;
                                        owl:minCardinality "1"^^xsd:nonNegativeInteger
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cpm:referencedBundleSpecV ;
                                        owl:minCardinality "1"^^xsd:nonNegativeInteger
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cpm:referencedMetaBundleId ;
                                        owl:minCardinality "1"^^xsd:nonNegativeInteger
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cpm:referencedMetaBundleSpecV ;
                                        owl:minCardinality "1"^^xsd:nonNegativeInteger
                                      ] ;
                      rdfs:comment "a connector that represents a received described object."@en ;
                      rdfs:isDefinedBy <https://www.commonprovenancemodel.org/cpm#> ;
                      rdfs:label "BackwardConnector"@en .


###  https://www.commonprovenancemodel.org/cpm#CurrentAgent
cpm:CurrentAgent rdf:type owl:Class ;
                 owl:equivalentClass cpm:currentAgent ;
                 rdfs:subClassOf prov:Organization ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cpm:contactIdPid ;
                                   owl:minCardinality "1"^^xsd:nonNegativeInteger
                                 ] ;
                 rdfs:comment "a provenance structure that represents a provenance controller."@en ;
                 rdfs:isDefinedBy <https://www.commonprovenancemodel.org/cpm#> ;
                 rdfs:label "CurrentAgent"@en .


###  https://www.commonprovenancemodel.org/cpm#ForwardConnector
cpm:ForwardConnector rdf:type owl:Class ;
                     owl:equivalentClass cpm:forwardConnector ;
                     rdfs:subClassOf prov:Entity ;
                     rdfs:comment "a connector that represents a described object that can be sent from a sender to a receiver."@en ;
                     rdfs:isDefinedBy <https://www.commonprovenancemodel.org/cpm#> ;
                     rdfs:label "ForwardConnector"@en .


###  https://www.commonprovenancemodel.org/cpm#ForwardConnectorSpecialized
cpm:ForwardConnectorSpecialized rdf:type owl:Class ;
                                owl:equivalentClass cpm:specForwardConnector ;
                                rdfs:subClassOf prov:Entity ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cpm:hashAlg ;
                                                  owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cpm:referencedBundleHashValue ;
                                                  owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cpm:referencedBundleId ;
                                                  owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cpm:referencedBundleSpecV ;
                                                  owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cpm:referencedMetaBundleId ;
                                                  owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cpm:referencedMetaBundleSpecV ;
                                                  owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                ] ;
                                rdfs:comment "a connector that represents a described object that has been sent from a sender to a receiver."@en ;
                                rdfs:isDefinedBy <https://www.commonprovenancemodel.org/cpm#> ;
                                rdfs:label "ForwardConnectorSpecialized"@en .


###  https://www.commonprovenancemodel.org/cpm#IdentifierEntity
cpm:IdentifierEntity rdf:type owl:Class ;
                     owl:equivalentClass cpm:id ;
                     rdfs:subClassOf prov:Entity ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cpm:externalId ;
                                       owl:minCardinality "1"^^xsd:nonNegativeInteger
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cpm:externalIdType ;
                                       owl:minCardinality "1"^^xsd:nonNegativeInteger
                                     ] ;
                     rdfs:comment "a provenance structure that represents an external identifier."@en ;
                     rdfs:isDefinedBy <https://www.commonprovenancemodel.org/cpm#> ;
                     rdfs:label "IdentifierEntity"@en .


###  https://www.commonprovenancemodel.org/cpm#MainActivity
cpm:MainActivity rdf:type owl:Class ;
                 owl:equivalentClass cpm:mainActivity ;
                 rdfs:subClassOf prov:Activity ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cpm:referencedMetaBundleId ;
                                   owl:minCardinality "1"^^xsd:nonNegativeInteger
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cpm:referencedMetaBundleSpecV ;
                                   owl:minCardinality "1"^^xsd:nonNegativeInteger
                                 ] ;
                 rdfs:comment "a provenance structure that represents the described activity documented in a particular provenance component."@en ;
                 rdfs:isDefinedBy <https://www.commonprovenancemodel.org/cpm#> ;
                 rdfs:label "MainActivity"@en .


###  https://www.commonprovenancemodel.org/cpm#ReceiverAgent
cpm:ReceiverAgent rdf:type owl:Class ;
                  owl:equivalentClass cpm:receiverAgent ;
                  rdfs:subClassOf prov:Organization ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cpm:contactIdPid ;
                                    owl:minCardinality "1"^^xsd:nonNegativeInteger
                                  ] ;
                  rdfs:comment "a provenance structure that represents a receiver in the context of passing a described object between two provenance controllers."@en ;
                  rdfs:isDefinedBy <https://www.commonprovenancemodel.org/cpm#> ;
                  rdfs:label "ReceiverAgent"@en .


###  https://www.commonprovenancemodel.org/cpm#SenderAgent
cpm:SenderAgent rdf:type owl:Class ;
                owl:equivalentClass cpm:senderAgent ;
                rdfs:subClassOf prov:Organization ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cpm:contactIdPid ;
                                  owl:minCardinality "1"^^xsd:nonNegativeInteger
                                ] ;
                rdfs:comment "a provenance structure that represents a sender in the context of passing a described object between two provenance controllers."@en ;
                rdfs:isDefinedBy <https://www.commonprovenancemodel.org/cpm#> ;
                rdfs:label "SenderAgent"@en .


###  https://www.commonprovenancemodel.org/cpm#backwardConnector
cpm:backwardConnector rdf:type owl:Class ;
                      vann:usageNote "CPM type value used with prov:type in PROV-N/PROV-JSON/PROV-XML (prov:type='cpm:backwardConnector'). Declared as a class equivalent to cpm:BackwardConnector so that the rdf:type triple produced from prov:type by the PROV-O mapping is classified as cpm:BackwardConnector."@en ;
                      rdfs:comment "a connector that represents a received described object."@en ;
                      rdfs:isDefinedBy <https://www.commonprovenancemodel.org/cpm#> ;
                      rdfs:label "backwardConnector"@en .


###  https://www.commonprovenancemodel.org/cpm#currentAgent
cpm:currentAgent rdf:type owl:Class ;
                 vann:usageNote "CPM type value used with prov:type in PROV-N/PROV-JSON/PROV-XML (prov:type='cpm:currentAgent'). Declared as a class equivalent to cpm:CurrentAgent so that the rdf:type triple produced from prov:type by the PROV-O mapping is classified as cpm:CurrentAgent."@en ;
                 rdfs:comment "a provenance structure that represents a provenance controller."@en ;
                 rdfs:isDefinedBy <https://www.commonprovenancemodel.org/cpm#> ;
                 rdfs:label "currentAgent"@en .


###  https://www.commonprovenancemodel.org/cpm#forwardConnector
cpm:forwardConnector rdf:type owl:Class ;
                     vann:usageNote "CPM type value used with prov:type in PROV-N/PROV-JSON/PROV-XML (prov:type='cpm:forwardConnector'). Declared as a class equivalent to cpm:ForwardConnector so that the rdf:type triple produced from prov:type by the PROV-O mapping is classified as cpm:ForwardConnector."@en ;
                     rdfs:comment "a connector that represents a described object that can be sent from a sender to a receiver."@en ;
                     rdfs:isDefinedBy <https://www.commonprovenancemodel.org/cpm#> ;
                     rdfs:label "forwardConnector"@en .


###  https://www.commonprovenancemodel.org/cpm#id
cpm:id rdf:type owl:Class ;
       vann:usageNote "CPM type value used with prov:type in PROV-N/PROV-JSON/PROV-XML (prov:type='cpm:id'). Declared as a class equivalent to cpm:IdentifierEntity so that the rdf:type triple produced from prov:type by the PROV-O mapping is classified as cpm:IdentifierEntity."@en ;
       rdfs:comment "a provenance structure that represents an external identifier."@en ;
       rdfs:isDefinedBy <https://www.commonprovenancemodel.org/cpm#> ;
       rdfs:label "id"@en .


###  https://www.commonprovenancemodel.org/cpm#mainActivity
cpm:mainActivity rdf:type owl:Class ;
                 vann:usageNote "CPM type value used with prov:type in PROV-N/PROV-JSON/PROV-XML (prov:type='cpm:mainActivity'). Declared as a class equivalent to cpm:MainActivity so that the rdf:type triple produced from prov:type by the PROV-O mapping is classified as cpm:MainActivity."@en ;
                 rdfs:comment "a provenance structure that represents the described activity documented in a particular provenance component."@en ;
                 rdfs:isDefinedBy <https://www.commonprovenancemodel.org/cpm#> ;
                 rdfs:label "mainActivity"@en .


###  https://www.commonprovenancemodel.org/cpm#receiverAgent
cpm:receiverAgent rdf:type owl:Class ;
                  vann:usageNote "CPM type value used with prov:type in PROV-N/PROV-JSON/PROV-XML (prov:type='cpm:receiverAgent'). Declared as a class equivalent to cpm:ReceiverAgent so that the rdf:type triple produced from prov:type by the PROV-O mapping is classified as cpm:ReceiverAgent."@en ;
                  rdfs:comment "a provenance structure that represents a receiver in the context of passing a described object between two provenance controllers."@en ;
                  rdfs:isDefinedBy <https://www.commonprovenancemodel.org/cpm#> ;
                  rdfs:label "receiverAgent"@en .


###  https://www.commonprovenancemodel.org/cpm#senderAgent
cpm:senderAgent rdf:type owl:Class ;
                vann:usageNote "CPM type value used with prov:type in PROV-N/PROV-JSON/PROV-XML (prov:type='cpm:senderAgent'). Declared as a class equivalent to cpm:SenderAgent so that the rdf:type triple produced from prov:type by the PROV-O mapping is classified as cpm:SenderAgent."@en ;
                rdfs:comment "a provenance structure that represents a sender in the context of passing a described object between two provenance controllers."@en ;
                rdfs:isDefinedBy <https://www.commonprovenancemodel.org/cpm#> ;
                rdfs:label "senderAgent"@en .


###  https://www.commonprovenancemodel.org/cpm#specForwardConnector
cpm:specForwardConnector rdf:type owl:Class ;
                         vann:usageNote "CPM type value used with prov:type in PROV-N/PROV-JSON/PROV-XML (prov:type='cpm:specForwardConnector'). Declared as a class equivalent to cpm:ForwardConnectorSpecialized so that the rdf:type triple produced from prov:type by the PROV-O mapping is classified as cpm:ForwardConnectorSpecialized."@en ;
                         rdfs:comment "a connector that represents a described object that has been sent from a sender to a receiver."@en ;
                         rdfs:isDefinedBy <https://www.commonprovenancemodel.org/cpm#> ;
                         rdfs:label "specForwardConnector"@en .


