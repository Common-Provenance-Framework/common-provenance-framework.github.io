  "@id" : "http://www.w3.org/2001/XMLSchema#date",
  "@type" : [ "http://www.w3.org/2000/01/rdf-schema#Datatype" ]
}, {
  "@id" : "https://www.commonprovenancemodel.org/cpm#",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/abstract" : [ {
    "@language" : "en",
    "@value" : "The Common Provenance Model Ontology (CPM-O) expresses the Common Provenance Model (CPM) using the OWL2 Web Ontology Language (OWL2). It provides a set of classes and properties that can be used to represent and interchange provenance information generated in different systems and under different contexts. It can also be specialized to create new classes and properties to model provenance information for different applications and domains. CPM-O and CPM are part of the Common Provenance Framework (CPF). CPM-O is an extension of PROV-O."
  } ],
  "http://purl.org/dc/terms/contributor" : [ {
    "@value" : "Cecilia Mascia"
  }, {
    "@value" : "Francesca Frexia"
  }, {
    "@value" : "Heimo Müller"
  }, {
    "@value" : "Jörg Geiger"
  }, {
    "@value" : "Markus Plass"
  }, {
    "@value" : "Matej Gallo"
  }, {
    "@value" : "Petr Holub"
  }, {
    "@value" : "Rudolf Wittner"
  } ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-02-05"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "CPM-O provides IRIs, labels and definitions for the terms of the Common Provenance Model (ISO 23494-2), so that these terms can be referenced from provenance documents expressed in PROV-N, PROV-JSON, PROV-XML or RDF. In this version the ontology serves primarily as a vocabulary: it declares the CPM classes and attributes and aligns them with PROV-O. The minimum cardinality restrictions it contains document requirements of ISO 23494-2 but, under the open-world semantics of OWL, they do not validate data. Constraints for checking conformance to ISO 23494-2 (e.g. exact cardinalities) and further features are planned for future versions."
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "http://creativecommons.org/licenses/by/4.0/"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "Common Provenance Model Ontology (CPM-O)"
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "cpm"
  } ],
  "http://purl.org/vocab/vann/preferredNamespaceUri" : [ {
    "@value" : "https://www.commonprovenancemodel.org/cpm#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Following PROV-O (Section 3.1), the PROV-DM attribute prov:type is expressed in RDF with rdf:type; CPM-O therefore does not declare prov:type. PROV-N, PROV-JSON and PROV-XML keep prov:type unchanged, e.g. prov:type='cpm:backwardConnector'. Each CPM type value (e.g. cpm:backwardConnector) is declared as a class equivalent to the corresponding CPM-O class (e.g. cpm:BackwardConnector), so RDF produced from PROV-N/PROV-JSON by standard PROV tooling is classified correctly. New RDF should use the capitalized class names."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "https://doi.org/10.5281/zenodo.19889324"
  }, {
    "@id" : "https://github.com/Common-Provenance-Framework"
  }, {
    "@id" : "https://www.commonprovenancemodel.org/PLACEHOLDER-known-issues"
  } ],
  "http://www.w3.org/2002/07/owl#imports" : [ {
    "@id" : "http://www.w3.org/ns/prov-o-20130430"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "https://www.commonprovenancemodel.org/cpm/1.0.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@language" : "en",
    "@value" : "1.0.0"
  } ]
}, {
