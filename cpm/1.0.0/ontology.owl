<?xml version="1.0"?>
<rdf:RDF xmlns="https://www.commonprovenancemodel.org/cpm#"
     xml:base="https://www.commonprovenancemodel.org/cpm"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://www.commonprovenancemodel.org/cpm#">
        <owl:versionIRI rdf:resource="https://www.commonprovenancemodel.org/cpm/1.0.0"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/prov-o-20130430"/>
        <terms:abstract xml:lang="en">The Common Provenance Model Ontology (CPM-O) expresses the Common Provenance Model (CPM) using the OWL2 Web Ontology Language (OWL2). It provides a set of classes and properties that can be used to represent and interchange provenance information generated in different systems and under different contexts. It can also be specialized to create new classes and properties to model provenance information for different applications and domains. CPM-O and CPM are part of the Common Provenance Framework (CPF). CPM-O is an extension of PROV-O.</terms:abstract>
        <terms:contributor>Cecilia Mascia</terms:contributor>
        <terms:contributor>Francesca Frexia</terms:contributor>
        <terms:contributor>Heimo Müller</terms:contributor>
        <terms:contributor>Jörg Geiger</terms:contributor>
        <terms:contributor>Markus Plass</terms:contributor>
        <terms:contributor>Matej Gallo</terms:contributor>
        <terms:contributor>Petr Holub</terms:contributor>
        <terms:contributor>Rudolf Wittner</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-02-05</terms:created>
        <terms:description xml:lang="en">CPM-O provides IRIs, labels and definitions for the terms of the Common Provenance Model (ISO 23494-2), so that these terms can be referenced from provenance documents expressed in PROV-N, PROV-JSON, PROV-XML or RDF. In this version the ontology serves primarily as a vocabulary: it declares the CPM classes and attributes and aligns them with PROV-O. The minimum cardinality restrictions it contains document requirements of ISO 23494-2 but, under the open-world semantics of OWL, they do not validate data. Constraints for checking conformance to ISO 23494-2 (e.g. exact cardinalities) and further features are planned for future versions.</terms:description>
        <terms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
        <terms:title xml:lang="en">Common Provenance Model Ontology (CPM-O)</terms:title>
        <vann:preferredNamespacePrefix>cpm</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://www.commonprovenancemodel.org/cpm#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">Following PROV-O (Section 3.1), the PROV-DM attribute prov:type is expressed in RDF with rdf:type; CPM-O therefore does not declare prov:type. PROV-N, PROV-JSON and PROV-XML keep prov:type unchanged, e.g. prov:type=&apos;cpm:backwardConnector&apos;. Each CPM type value (e.g. cpm:backwardConnector) is declared as a class equivalent to the corresponding CPM-O class (e.g. cpm:BackwardConnector), so RDF produced from PROV-N/PROV-JSON by standard PROV tooling is classified correctly. New RDF should use the capitalized class names.</rdfs:comment>
        <rdfs:seeAlso rdf:resource="https://doi.org/10.5281/zenodo.19889324"/>
        <rdfs:seeAlso rdf:resource="https://github.com/Common-Provenance-Framework"/>
        <rdfs:seeAlso rdf:resource="https://www.commonprovenancemodel.org/PLACEHOLDER-known-issues"/>
        <owl:versionInfo xml:lang="en">1.0.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/abstract -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/abstract"/>
    


    <!-- http://purl.org/dc/terms/contributor -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/contributor"/>
    


    <!-- http://purl.org/dc/terms/created -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- http://purl.org/vocab/vann/usageNote -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/usageNote"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://www.commonprovenancemodel.org/cpm#comment -->


    <owl:DatatypeProperty rdf:about="https://www.commonprovenancemodel.org/cpm#comment">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/ns/prov#Activity"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/prov#Agent"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/prov#Entity"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">arbitrary comment or additional information.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.commonprovenancemodel.org/cpm#"/>
        <rdfs:label xml:lang="en">comment</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.commonprovenancemodel.org/cpm#contactIdPid -->


    <owl:DatatypeProperty rdf:about="https://www.commonprovenancemodel.org/cpm#contactIdPid">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">a resolvable persistent identifier dereferencing to actual contact information (e.g. email address) that can be used to contact a person or organization represented by a particular agent. The value of this attribute is the full IRI of the persistent identifier, given as a literal of type xsd:anyURI.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.commonprovenancemodel.org/cpm#"/>
        <rdfs:label xml:lang="en">contactIdPid</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.commonprovenancemodel.org/cpm#describedObjectType -->


    <owl:DatatypeProperty rdf:about="https://www.commonprovenancemodel.org/cpm#describedObjectType">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">type of the object represented by the PROV entity</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.commonprovenancemodel.org/cpm#"/>
        <rdfs:label xml:lang="en">describedObjectType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.commonprovenancemodel.org/cpm#externalId -->


    <owl:DatatypeProperty rdf:about="https://www.commonprovenancemodel.org/cpm#externalId">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/ns/prov#Activity"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/prov#Agent"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/prov#Entity"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">external identifier of a described object or a described activity, which is represented by a PROV entity, PROV activity or PROV agent.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.commonprovenancemodel.org/cpm#"/>
        <rdfs:label xml:lang="en">externalId</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.commonprovenancemodel.org/cpm#externalIdType -->


    <owl:DatatypeProperty rdf:about="https://www.commonprovenancemodel.org/cpm#externalIdType">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/ns/prov#Activity"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/prov#Agent"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/prov#Entity"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">type of the external identifier</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.commonprovenancemodel.org/cpm#"/>
        <rdfs:label xml:lang="en">externalIdType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.commonprovenancemodel.org/cpm#hasId -->


    <owl:DatatypeProperty rdf:about="https://www.commonprovenancemodel.org/cpm#hasId">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">an indication whether the PROV entity having this attribute has an external identifier expressed as a standalone entity</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.commonprovenancemodel.org/cpm#"/>
        <rdfs:label xml:lang="en">hasId</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.commonprovenancemodel.org/cpm#hashAlg -->


    <owl:DatatypeProperty rdf:about="https://www.commonprovenancemodel.org/cpm#hashAlg">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">algorithm used to create a hashValue</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.commonprovenancemodel.org/cpm#"/>
        <rdfs:label xml:lang="en">hashAlg</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.commonprovenancemodel.org/cpm#hashValue -->


    <owl:DatatypeProperty rdf:about="https://www.commonprovenancemodel.org/cpm#hashValue">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <vann:usageNote xml:lang="en">It is always used together with cpm:hashAlg.</vann:usageNote>
        <rdfs:comment xml:lang="en">a hash value of a described object, which is represented by the PROV entity, presuming that the described object is a digital object and not a physical object.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.commonprovenancemodel.org/cpm#"/>
        <rdfs:label xml:lang="en">hashValue</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.commonprovenancemodel.org/cpm#provenanceServiceUri -->


    <owl:DatatypeProperty rdf:about="https://www.commonprovenancemodel.org/cpm#provenanceServiceUri">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.commonprovenancemodel.org/cpm#BackwardConnector"/>
                    <rdf:Description rdf:about="https://www.commonprovenancemodel.org/cpm#ForwardConnectorSpecialized"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">URI of a service where a finalized provenance component can be requested using its identifier</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.commonprovenancemodel.org/cpm#"/>
        <rdfs:label xml:lang="en">provenanceServiceUri</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.commonprovenancemodel.org/cpm#referencedBundleHashValue -->


    <owl:DatatypeProperty rdf:about="https://www.commonprovenancemodel.org/cpm#referencedBundleHashValue">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.commonprovenancemodel.org/cpm#BackwardConnector"/>
                    <rdf:Description rdf:about="https://www.commonprovenancemodel.org/cpm#ForwardConnectorSpecialized"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">a hash value of a provenance component referenced by the connector in which the attribute is present</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.commonprovenancemodel.org/cpm#"/>
        <rdfs:label xml:lang="en">referencedBundleHashValue</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.commonprovenancemodel.org/cpm#referencedBundleId -->


    <owl:DatatypeProperty rdf:about="https://www.commonprovenancemodel.org/cpm#referencedBundleId">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.commonprovenancemodel.org/cpm#BackwardConnector"/>
                    <rdf:Description rdf:about="https://www.commonprovenancemodel.org/cpm#ForwardConnectorSpecialized"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">identifier of a finalized provenance component referenced by the connector that contains this attribute</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.commonprovenancemodel.org/cpm#"/>
        <rdfs:label xml:lang="en">referencedBundleId</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.commonprovenancemodel.org/cpm#referencedBundleSpecV -->


    <owl:DatatypeProperty rdf:about="https://www.commonprovenancemodel.org/cpm#referencedBundleSpecV">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.commonprovenancemodel.org/cpm#BackwardConnector"/>
                    <rdf:Description rdf:about="https://www.commonprovenancemodel.org/cpm#ForwardConnectorSpecialized"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <vann:usageNote xml:lang="en">A value specifying an ISO document has the format ISO-[DOC_TYPE]-[PROJECT-CODE]-[PART]:[YEAR-OF-PUBLICATION], where DOC_TYPE is IS, TS or PAS, e.g. ISO-IS-23494-2:2026.</vann:usageNote>
        <rdfs:comment xml:lang="en">specification of the CPM version that is used to represent the content of the referenced finalized provenance component. Used together with the cpm:referencedBundleId attribute.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.commonprovenancemodel.org/cpm#"/>
        <rdfs:label xml:lang="en">referencedBundleSpecV</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.commonprovenancemodel.org/cpm#referencedMetaBundleId -->


    <owl:DatatypeProperty rdf:about="https://www.commonprovenancemodel.org/cpm#referencedMetaBundleId">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.commonprovenancemodel.org/cpm#BackwardConnector"/>
                    <rdf:Description rdf:about="https://www.commonprovenancemodel.org/cpm#ForwardConnectorSpecialized"/>
                    <rdf:Description rdf:about="https://www.commonprovenancemodel.org/cpm#MainActivity"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">identifier of a meta-component that contains respective finalized provenance component’s metadata</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.commonprovenancemodel.org/cpm#"/>
        <rdfs:label xml:lang="en">referencedMetaBundleId</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.commonprovenancemodel.org/cpm#referencedMetaBundleSpecV -->


    <owl:DatatypeProperty rdf:about="https://www.commonprovenancemodel.org/cpm#referencedMetaBundleSpecV">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.commonprovenancemodel.org/cpm#BackwardConnector"/>
                    <rdf:Description rdf:about="https://www.commonprovenancemodel.org/cpm#ForwardConnectorSpecialized"/>
                    <rdf:Description rdf:about="https://www.commonprovenancemodel.org/cpm#MainActivity"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <vann:usageNote xml:lang="en">A value specifying an ISO document has the format ISO-[DOC_TYPE]-[PROJECT-CODE]-[PART]:[YEAR-OF-PUBLICATION], where DOC_TYPE is IS, TS or PAS, e.g. ISO-IS-23494-2:2026.</vann:usageNote>
        <rdfs:comment xml:lang="en">specification of the CPM version that is used to represent the content of the referenced meta-component. Used together with the cpm:referencedMetaBundleId attribute.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.commonprovenancemodel.org/cpm#"/>
        <rdfs:label xml:lang="en">referencedMetaBundleSpecV</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://www.commonprovenancemodel.org/cpm#BackwardConnector -->


    <owl:Class rdf:about="https://www.commonprovenancemodel.org/cpm#BackwardConnector">
        <owl:equivalentClass rdf:resource="https://www.commonprovenancemodel.org/cpm#backwardConnector"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.commonprovenancemodel.org/cpm#hashAlg"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.commonprovenancemodel.org/cpm#referencedBundleHashValue"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.commonprovenancemodel.org/cpm#referencedBundleId"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.commonprovenancemodel.org/cpm#referencedBundleSpecV"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.commonprovenancemodel.org/cpm#referencedMetaBundleId"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.commonprovenancemodel.org/cpm#referencedMetaBundleSpecV"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A connector that represents a received described object</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.commonprovenancemodel.org/cpm#"/>
        <rdfs:label xml:lang="en">BackwardConnector</rdfs:label>
    </owl:Class>
    


    <!-- https://www.commonprovenancemodel.org/cpm#CurrentAgent -->


    <owl:Class rdf:about="https://www.commonprovenancemodel.org/cpm#CurrentAgent">
        <owl:equivalentClass rdf:resource="https://www.commonprovenancemodel.org/cpm#currentAgent"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Organization"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.commonprovenancemodel.org/cpm#contactIdPid"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A provenance structure that represents a provenance controller</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.commonprovenancemodel.org/cpm#"/>
        <rdfs:label xml:lang="en">CurrentAgent</rdfs:label>
    </owl:Class>
    


    <!-- https://www.commonprovenancemodel.org/cpm#ForwardConnector -->


    <owl:Class rdf:about="https://www.commonprovenancemodel.org/cpm#ForwardConnector">
        <owl:equivalentClass rdf:resource="https://www.commonprovenancemodel.org/cpm#forwardConnector"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">A connector that represents a described object that can be sent from a sender to a receiver</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.commonprovenancemodel.org/cpm#"/>
        <rdfs:label xml:lang="en">ForwardConnector</rdfs:label>
    </owl:Class>
    


    <!-- https://www.commonprovenancemodel.org/cpm#ForwardConnectorSpecialized -->


    <owl:Class rdf:about="https://www.commonprovenancemodel.org/cpm#ForwardConnectorSpecialized">
        <owl:equivalentClass rdf:resource="https://www.commonprovenancemodel.org/cpm#specForwardConnector"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.commonprovenancemodel.org/cpm#hashAlg"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.commonprovenancemodel.org/cpm#referencedBundleHashValue"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
