    <!-- https://www.commonprovenancemodel.org/ns/pdg#Data -->


    <owl:Class rdf:about="https://www.commonprovenancemodel.org/ns/pdg#Data">
        <owl:equivalentClass rdf:resource="https://www.commonprovenancemodel.org/ns/pdg#data"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">a provenance structure that represents data.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.commonprovenancemodel.org/ns/pdg#"/>
        <rdfs:label xml:lang="en">Data</rdfs:label>
    </owl:Class>
    


    <!-- https://www.commonprovenancemodel.org/ns/pdg#DataGeneration -->


    <owl:Class rdf:about="https://www.commonprovenancemodel.org/ns/pdg#DataGeneration">
        <owl:equivalentClass rdf:resource="https://www.commonprovenancemodel.org/ns/pdg#dataGeneration"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#startedAtTime"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">a provenance structure that represents a data generation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.commonprovenancemodel.org/ns/pdg#"/>
        <rdfs:label xml:lang="en">DataGeneration</rdfs:label>
    </owl:Class>
    


    <!-- https://www.commonprovenancemodel.org/ns/pdg#DataGenerationDevice -->


    <owl:Class rdf:about="https://www.commonprovenancemodel.org/ns/pdg#DataGenerationDevice">
        <owl:equivalentClass rdf:resource="https://www.commonprovenancemodel.org/ns/pdg#dataGenerationDevice"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:comment xml:lang="en">a provenance structure that represents a device for data generation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.commonprovenancemodel.org/ns/pdg#"/>
        <rdfs:label xml:lang="en">DataGenerationDevice</rdfs:label>
    </owl:Class>
    


    <!-- https://www.commonprovenancemodel.org/ns/pdg#DataGenerationOther -->


    <owl:Class rdf:about="https://www.commonprovenancemodel.org/ns/pdg#DataGenerationOther">
        <owl:equivalentClass rdf:resource="https://www.commonprovenancemodel.org/ns/pdg#dataGenerationOther"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:comment xml:lang="en">a provenance structure that represents an agent for data generation different from software and device.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.commonprovenancemodel.org/ns/pdg#"/>
        <rdfs:label xml:lang="en">DataGenerationOther</rdfs:label>
    </owl:Class>
    


    <!-- https://www.commonprovenancemodel.org/ns/pdg#DataGenerationSW -->


    <owl:Class rdf:about="https://www.commonprovenancemodel.org/ns/pdg#DataGenerationSW">
        <owl:equivalentClass rdf:resource="https://www.commonprovenancemodel.org/ns/pdg#dataGenerationSW"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:comment xml:lang="en">a provenance structure that represents a software for data generation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.commonprovenancemodel.org/ns/pdg#"/>
        <rdfs:label xml:lang="en">DataGenerationSW</rdfs:label>
    </owl:Class>
    


    <!-- https://www.commonprovenancemodel.org/ns/pdg#data -->


    <owl:Class rdf:about="https://www.commonprovenancemodel.org/ns/pdg#data">
        <vann:usageNote xml:lang="en">PDG type value used with prov:type in PROV-N/PROV-JSON/PROV-XML (prov:type=&apos;pdg:data&apos;). Declared as a class equivalent to pdg:Data so that the rdf:type triple produced from prov:type by the PROV-O mapping is classified as pdg:Data.</vann:usageNote>
        <rdfs:comment xml:lang="en">a provenance structure that represents data.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.commonprovenancemodel.org/ns/pdg#"/>
        <rdfs:label xml:lang="en">data</rdfs:label>
    </owl:Class>
    


    <!-- https://www.commonprovenancemodel.org/ns/pdg#dataGeneration -->


    <owl:Class rdf:about="https://www.commonprovenancemodel.org/ns/pdg#dataGeneration">
        <vann:usageNote xml:lang="en">PDG type value used with prov:type in PROV-N/PROV-JSON/PROV-XML (prov:type=&apos;pdg:dataGeneration&apos;). Declared as a class equivalent to pdg:DataGeneration so that the rdf:type triple produced from prov:type by the PROV-O mapping is classified as pdg:DataGeneration.</vann:usageNote>
        <rdfs:comment xml:lang="en">a provenance structure that represents a data generation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.commonprovenancemodel.org/ns/pdg#"/>
        <rdfs:label xml:lang="en">dataGeneration</rdfs:label>
    </owl:Class>
    


    <!-- https://www.commonprovenancemodel.org/ns/pdg#dataGenerationDevice -->


    <owl:Class rdf:about="https://www.commonprovenancemodel.org/ns/pdg#dataGenerationDevice">
        <vann:usageNote xml:lang="en">PDG type value used with prov:type in PROV-N/PROV-JSON/PROV-XML (prov:type=&apos;pdg:dataGenerationDevice&apos;). Declared as a class equivalent to pdg:DataGenerationDevice so that the rdf:type triple produced from prov:type by the PROV-O mapping is classified as pdg:DataGenerationDevice.</vann:usageNote>
        <rdfs:comment xml:lang="en">a provenance structure that represents a device for data generation.</rdfs:comment>
