    "@value" : "senderAgent"
  } ]
}, {
  "@id" : "https://www.commonprovenancemodel.org/ns/cpm#specForwardConnector",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/vocab/vann/usageNote" : [ {
    "@language" : "en",
    "@value" : "CPM type value used with prov:type in PROV-N/PROV-JSON/PROV-XML (prov:type='cpm:specForwardConnector'). Declared as a class equivalent to cpm:ForwardConnectorSpecialized so that the rdf:type triple produced from prov:type by the PROV-O mapping is classified as cpm:ForwardConnectorSpecialized."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "a connector that represents a described object that has been sent from a sender to a receiver."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://www.commonprovenancemodel.org/ns/cpm#"
  } ],
