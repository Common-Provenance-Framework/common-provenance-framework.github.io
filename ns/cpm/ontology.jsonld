}, {
  "@id" : "https://www.commonprovenancemodel.org/ns/cpm#",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/abstract" : [ {
    "@language" : "en",
    "@value" : "The Common Provenance Model Ontology (CPM-O) expresses the Common Provenance Model (CPM) using the OWL 2 Web Ontology Language (OWL 2). It provides a set of classes and properties that can be used to represent and interchange provenance information generated by different organizations in different systems and under different contexts. It can also be specialized to create new classes and properties to model provenance information for different applications and domains. CPM-O and CPM are part of the Common Provenance Framework (CPF). CPM-O is an extension of PROV-O. The CPM is standardized as ISO 23494-2 (Provenance information model for biological material and data — Part 2: Common provenance model)."
  } ],
  "http://purl.org/dc/terms/contributor" : [ {
    "@value" : "Cecilia Mascia"
  }, {
    "@value" : "Francesca Frexia"
  }, {
    "@value" : "Heimo Müller"
  }, {
    "@value" : "Jörg Geiger"
  }, {
    "@value" : "Markus Plass"
  }, {
    "@value" : "Matej Gallo"
  }, {
    "@value" : "Petr Holub"
  }, {
    "@value" : "Rudolf Wittner"
  } ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-02-05"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "Each CPM type value (e.g. cpm:backwardConnector) is declared as a class equivalent to the corresponding CPM-O class (e.g. cpm:BackwardConnector), so RDF produced from PROV-N/PROV-JSON by standard PROV tooling is classified correctly. The implementations should use the capitalized class names."
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "http://creativecommons.org/licenses/by/4.0/"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "Common Provenance Model Ontology (CPM-O)"
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "cpm"
  } ],
  "http://purl.org/vocab/vann/preferredNamespaceUri" : [ {
    "@value" : "https://www.commonprovenancemodel.org/ns/cpm#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "https://doi.org/10.5281/zenodo.19889324"
  }, {
    "@id" : "https://github.com/Common-Provenance-Framework"
  }, {
    "@id" : "https://www.commonprovenancemodel.org/ontologies/known-issues/"
  } ],
  "http://www.w3.org/2002/07/owl#imports" : [ {
    "@id" : "http://www.w3.org/ns/prov-o-20130430"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
