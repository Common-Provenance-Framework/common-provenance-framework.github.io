}, {
  "@id" : "https://www.commonprovenancemodel.org/ns/cpm#senderAgent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/vocab/vann/usageNote" : [ {
    "@language" : "en",
    "@value" : "CPM type value used with prov:type in PROV-N/PROV-JSON/PROV-XML (prov:type='cpm:senderAgent'). Declared as a class equivalent to cpm:SenderAgent so that the rdf:type triple produced from prov:type by the PROV-O mapping is classified as cpm:SenderAgent."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "a provenance structure that represents a sender in the context of passing a described object between two provenance controllers."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://www.commonprovenancemodel.org/ns/cpm#"
