    "@language" : "en",
    "@value" : "A value specifying an ISO document has the format ISO-[DOC_TYPE]-[PROJECT-CODE]-[PART]:[YEAR-OF-PUBLICATION], where DOC_TYPE is IS, TS or PAS, e.g. ISO-IS-23494-2:2026."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "specification of the CPM version that is used to represent the content of the referenced finalized provenance component. Used together with the cpm:referencedBundleId attribute."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
