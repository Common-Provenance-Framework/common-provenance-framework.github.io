@prefix : <https://www.commonprovenancemodel.org/ns/cpm#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://www.commonprovenancemodel.org/ns/cpm#> .

<https://www.commonprovenancemodel.org/ns/cpm#> rdf:type owl:Ontology ;
                                                 owl:versionIRI <https://www.commonprovenancemodel.org/ns/cpm/1.0.0> ;
                                                 owl:imports <http://www.w3.org/ns/prov-o-20130430> ;
                                                 <http://purl.org/dc/terms/abstract> "The Common Provenance Model Ontology (CPM-O) expresses the Common Provenance Model (CPM) using the OWL 2 Web Ontology Language (OWL 2). It provides a set of classes and properties that can be used to represent and interchange provenance information generated by different organizations in different systems and under different contexts. It can also be specialized to create new classes and properties to model provenance information for different applications and domains. CPM-O and CPM are part of the Common Provenance Framework (CPF). CPM-O is an extension of PROV-O. The CPM is standardized as ISO 23494-2 (Provenance information model for biological material and data — Part 2: Common provenance model)."@en ;
                                                 <http://purl.org/dc/terms/contributor> "Cecilia Mascia" ,
                                                                                        "Francesca Frexia" ,
                                                                                        "Heimo Müller" ,
                                                                                        "Jörg Geiger" ,
                                                                                        "Markus Plass" ,
                                                                                        "Matej Gallo" ,
                                                                                        "Petr Holub" ,
                                                                                        "Rudolf Wittner" ;
                                                 <http://purl.org/dc/terms/created> "2026-02-05"^^xsd:date ;
                                                 <http://purl.org/dc/terms/description> "Each CPM type value (e.g. cpm:backwardConnector) is declared as a class equivalent to the corresponding CPM-O class (e.g. cpm:BackwardConnector), so RDF produced from PROV-N/PROV-JSON by standard PROV tooling is classified correctly. The implementations should use the capitalized class names."@en ;
                                                 <http://purl.org/dc/terms/license> <http://creativecommons.org/licenses/by/4.0/> ;
                                                 <http://purl.org/dc/terms/title> "Common Provenance Model Ontology (CPM-O)"@en ;
                                                 <http://purl.org/vocab/vann/preferredNamespacePrefix> "cpm" ;
                                                 <http://purl.org/vocab/vann/preferredNamespaceUri> "https://www.commonprovenancemodel.org/ns/cpm#" ;
                                                 rdfs:seeAlso <https://doi.org/10.5281/zenodo.19889324> ,
                                                              <https://github.com/Common-Provenance-Framework> ,
                                                              <https://www.commonprovenancemodel.org/ontologies/known-issues/> ;
                                                 owl:versionInfo "1.0.0"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/abstract
<http://purl.org/dc/terms/abstract> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/contributor
<http://purl.org/dc/terms/contributor> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
<http://purl.org/vocab/vann/preferredNamespaceUri> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/usageNote
<http://purl.org/vocab/vann/usageNote> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Data properties
#################################################################

###  https://www.commonprovenancemodel.org/ns/cpm#comment
:comment rdf:type owl:DatatypeProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( <http://www.w3.org/ns/prov#Activity>
                                     <http://www.w3.org/ns/prov#Agent>
                                     <http://www.w3.org/ns/prov#Entity>
                                   )
                     ] ;
         rdfs:range [ rdf:type rdfs:Datatype ;
                      owl:unionOf ( rdf:langString
                                    xsd:string
                                  )
                    ] ;
         rdfs:comment "arbitrary comment or additional information."@en ;
         rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/cpm#> ;
         rdfs:label "comment"@en .


###  https://www.commonprovenancemodel.org/ns/cpm#contactIdPid
:contactIdPid rdf:type owl:DatatypeProperty ;
              rdfs:domain <http://www.w3.org/ns/prov#Agent> ;
              rdfs:range xsd:anyURI ;
              rdfs:comment "a resolvable persistent identifier dereferencing to actual contact information (e.g. email address) that can be used to contact a person or organization represented by a particular agent. The value of this attribute is the full IRI of the persistent identifier, given as a literal of type xsd:anyURI."@en ;
              rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/cpm#> ;
              rdfs:label "contactIdPid"@en .


###  https://www.commonprovenancemodel.org/ns/cpm#describedObjectType
:describedObjectType rdf:type owl:DatatypeProperty ;
                     rdfs:domain <http://www.w3.org/ns/prov#Entity> ;
                     rdfs:range xsd:string ;
                     rdfs:comment "type of the object represented by the PROV entity"@en ;
                     rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/cpm#> ;
                     rdfs:label "describedObjectType"@en .


###  https://www.commonprovenancemodel.org/ns/cpm#externalId
:externalId rdf:type owl:DatatypeProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( <http://www.w3.org/ns/prov#Activity>
                                        <http://www.w3.org/ns/prov#Agent>
                                        <http://www.w3.org/ns/prov#Entity>
                                      )
                        ] ;
            rdfs:range xsd:string ;
            rdfs:comment "external identifier of a described object or a described activity, which is represented by a PROV entity, PROV activity or PROV agent."@en ;
            rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/cpm#> ;
            rdfs:label "externalId"@en .


###  https://www.commonprovenancemodel.org/ns/cpm#externalIdType
:externalIdType rdf:type owl:DatatypeProperty ;
                rdfs:domain :IdentifierEntity ;
                rdfs:range xsd:string ;
                rdfs:comment "type of the external identifier represented by an identifier entity (cpm:id)"@en ;
                rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/cpm#> ;
                rdfs:label "externalIdType"@en .


###  https://www.commonprovenancemodel.org/ns/cpm#hasId
:hasId rdf:type owl:DatatypeProperty ;
       rdfs:domain <http://www.w3.org/ns/prov#Entity> ;
       rdfs:range xsd:anyURI ;
       rdfs:comment "a reference from a PROV entity representing a described object to the identifier entity (cpm:id) that represents the identifier of the described object. The value of this attribute is the identifier of the identifier entity, given as a full IRI of type xsd:anyURI. The two entities are related by prov:alternateOf."@en ;
       rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/cpm#> ;
       rdfs:label "hasId"@en .


###  https://www.commonprovenancemodel.org/ns/cpm#hashAlg
:hashAlg rdf:type owl:DatatypeProperty ;
         rdfs:domain <http://www.w3.org/ns/prov#Entity> ;
         rdfs:range xsd:string ;
         rdfs:comment "algorithm used to create a hashValue"@en ;
         rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/cpm#> ;
         rdfs:label "hashAlg"@en .


###  https://www.commonprovenancemodel.org/ns/cpm#hashValue
:hashValue rdf:type owl:DatatypeProperty ;
           rdfs:domain <http://www.w3.org/ns/prov#Entity> ;
           rdfs:range xsd:string ;
           <http://purl.org/vocab/vann/usageNote> "It is always used together with cpm:hashAlg."@en ;
           rdfs:comment "a hash value of a described object, which is represented by the PROV entity, presuming that the described object is a digital object and not a physical object."@en ;
           rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/cpm#> ;
           rdfs:label "hashValue"@en .


###  https://www.commonprovenancemodel.org/ns/cpm#provenanceServiceUri
:provenanceServiceUri rdf:type owl:DatatypeProperty ;
                      rdfs:domain [ rdf:type owl:Class ;
                                    owl:unionOf ( :BackwardConnector
                                                  :ForwardConnectorSpecialized
                                                )
                                  ] ;
                      rdfs:range xsd:anyURI ;
                      rdfs:comment "URI of a service where a finalized provenance component can be requested using its identifier"@en ;
                      rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/cpm#> ;
                      rdfs:label "provenanceServiceUri"@en .


###  https://www.commonprovenancemodel.org/ns/cpm#referencedBundleHashValue
:referencedBundleHashValue rdf:type owl:DatatypeProperty ;
                           rdfs:domain [ rdf:type owl:Class ;
                                         owl:unionOf ( :BackwardConnector
                                                       :ForwardConnectorSpecialized
                                                     )
                                       ] ;
                           rdfs:range xsd:string ;
                           rdfs:comment "a hash value of a provenance component referenced by the connector in which the attribute is present"@en ;
                           rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/cpm#> ;
                           rdfs:label "referencedBundleHashValue"@en .


###  https://www.commonprovenancemodel.org/ns/cpm#referencedBundleId
:referencedBundleId rdf:type owl:DatatypeProperty ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( :BackwardConnector
                                                :ForwardConnectorSpecialized
                                              )
                                ] ;
                    rdfs:range xsd:anyURI ;
                    rdfs:comment "identifier of a finalized provenance component referenced by the connector that contains this attribute"@en ;
                    rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/cpm#> ;
                    rdfs:label "referencedBundleId"@en .


###  https://www.commonprovenancemodel.org/ns/cpm#referencedBundleSpecV
:referencedBundleSpecV rdf:type owl:DatatypeProperty ;
                       rdfs:domain [ rdf:type owl:Class ;
                                     owl:unionOf ( :BackwardConnector
                                                   :ForwardConnectorSpecialized
                                                 )
                                   ] ;
                       rdfs:range xsd:string ;
                       <http://purl.org/vocab/vann/usageNote> "A value specifying an ISO document has the format ISO-[DOC_TYPE]-[PROJECT-CODE]-[PART]:[YEAR-OF-PUBLICATION], where DOC_TYPE is IS, TS or PAS, e.g. ISO-IS-23494-2:2026."@en ;
                       rdfs:comment "specification of the CPM version that is used to represent the content of the referenced finalized provenance component. Used together with the cpm:referencedBundleId attribute."@en ;
                       rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/cpm#> ;
                       rdfs:label "referencedBundleSpecV"@en .


###  https://www.commonprovenancemodel.org/ns/cpm#referencedMetaBundleId
:referencedMetaBundleId rdf:type owl:DatatypeProperty ;
                        rdfs:domain [ rdf:type owl:Class ;
                                      owl:unionOf ( :BackwardConnector
                                                    :ForwardConnectorSpecialized
                                                    :MainActivity
                                                  )
                                    ] ;
                        rdfs:range xsd:anyURI ;
                        rdfs:comment "identifier of a meta-component that contains respective finalized provenance component’s metadata"@en ;
                        rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/cpm#> ;
                        rdfs:label "referencedMetaBundleId"@en .


###  https://www.commonprovenancemodel.org/ns/cpm#referencedMetaBundleSpecV
:referencedMetaBundleSpecV rdf:type owl:DatatypeProperty ;
                           rdfs:domain [ rdf:type owl:Class ;
                                         owl:unionOf ( :BackwardConnector
                                                       :ForwardConnectorSpecialized
                                                       :MainActivity
                                                     )
                                       ] ;
                           rdfs:range xsd:string ;
                           <http://purl.org/vocab/vann/usageNote> "A value specifying an ISO document has the format ISO-[DOC_TYPE]-[PROJECT-CODE]-[PART]:[YEAR-OF-PUBLICATION], where DOC_TYPE is IS, TS or PAS, e.g. ISO-IS-23494-2:2026."@en ;
                           rdfs:comment "specification of the CPM version that is used to represent the content of the referenced meta-component. Used together with the cpm:referencedMetaBundleId attribute."@en ;
                           rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/cpm#> ;
                           rdfs:label "referencedMetaBundleSpecV"@en .


#################################################################
#    Classes
#################################################################

###  https://www.commonprovenancemodel.org/ns/cpm#BackwardConnector
:BackwardConnector rdf:type owl:Class ;
                   owl:equivalentClass :backwardConnector ;
                   rdfs:subClassOf <http://www.w3.org/ns/prov#Entity> ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hashAlg ;
                                     owl:minCardinality "1"^^xsd:nonNegativeInteger
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :referencedBundleHashValue ;
                                     owl:minCardinality "1"^^xsd:nonNegativeInteger
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :referencedBundleId ;
                                     owl:minCardinality "1"^^xsd:nonNegativeInteger
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :referencedBundleSpecV ;
                                     owl:minCardinality "1"^^xsd:nonNegativeInteger
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :referencedMetaBundleId ;
                                     owl:minCardinality "1"^^xsd:nonNegativeInteger
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :referencedMetaBundleSpecV ;
                                     owl:minCardinality "1"^^xsd:nonNegativeInteger
                                   ] ;
                   rdfs:comment "a connector that represents a received described object."@en ;
                   rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/cpm#> ;
                   rdfs:label "BackwardConnector"@en .


###  https://www.commonprovenancemodel.org/ns/cpm#CurrentAgent
:CurrentAgent rdf:type owl:Class ;
              owl:equivalentClass :currentAgent ;
              rdfs:subClassOf <http://www.w3.org/ns/prov#Organization> ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :contactIdPid ;
                                owl:minCardinality "1"^^xsd:nonNegativeInteger
                              ] ;
              rdfs:comment "a provenance structure that represents a provenance controller."@en ;
              rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/cpm#> ;
              rdfs:label "CurrentAgent"@en .


###  https://www.commonprovenancemodel.org/ns/cpm#ForwardConnector
:ForwardConnector rdf:type owl:Class ;
                  owl:equivalentClass :forwardConnector ;
                  rdfs:subClassOf <http://www.w3.org/ns/prov#Entity> ;
                  rdfs:comment "a connector that represents a described object that can be sent from a sender to a receiver."@en ;
                  rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/cpm#> ;
                  rdfs:label "ForwardConnector"@en .


###  https://www.commonprovenancemodel.org/ns/cpm#ForwardConnectorSpecialized
:ForwardConnectorSpecialized rdf:type owl:Class ;
                             owl:equivalentClass :specForwardConnector ;
                             rdfs:subClassOf <http://www.w3.org/ns/prov#Entity> ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty :hashAlg ;
                                               owl:minCardinality "1"^^xsd:nonNegativeInteger
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty :referencedBundleHashValue ;
                                               owl:minCardinality "1"^^xsd:nonNegativeInteger
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty :referencedBundleId ;
                                               owl:minCardinality "1"^^xsd:nonNegativeInteger
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty :referencedBundleSpecV ;
                                               owl:minCardinality "1"^^xsd:nonNegativeInteger
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty :referencedMetaBundleId ;
                                               owl:minCardinality "1"^^xsd:nonNegativeInteger
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty :referencedMetaBundleSpecV ;
                                               owl:minCardinality "1"^^xsd:nonNegativeInteger
                                             ] ;
                             rdfs:comment "a connector that represents a described object that has been sent from a sender to a receiver."@en ;
                             rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/cpm#> ;
                             rdfs:label "ForwardConnectorSpecialized"@en .


###  https://www.commonprovenancemodel.org/ns/cpm#IdentifierEntity
:IdentifierEntity rdf:type owl:Class ;
                  owl:equivalentClass :id ;
                  rdfs:subClassOf <http://www.w3.org/ns/prov#Entity> ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :externalId ;
                                    owl:minCardinality "1"^^xsd:nonNegativeInteger
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :externalIdType ;
                                    owl:minCardinality "1"^^xsd:nonNegativeInteger
                                  ] ;
                  rdfs:comment "a provenance structure that represents an external identifier."@en ;
                  rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/cpm#> ;
                  rdfs:label "IdentifierEntity"@en .


###  https://www.commonprovenancemodel.org/ns/cpm#MainActivity
:MainActivity rdf:type owl:Class ;
              owl:equivalentClass :mainActivity ;
              rdfs:subClassOf <http://www.w3.org/ns/prov#Activity> ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :referencedMetaBundleId ;
                                owl:minCardinality "1"^^xsd:nonNegativeInteger
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :referencedMetaBundleSpecV ;
                                owl:minCardinality "1"^^xsd:nonNegativeInteger
                              ] ;
              rdfs:comment "a provenance structure that represents the described activity documented in a particular provenance component."@en ;
              rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/cpm#> ;
              rdfs:label "MainActivity"@en .


###  https://www.commonprovenancemodel.org/ns/cpm#ReceiverAgent
:ReceiverAgent rdf:type owl:Class ;
               owl:equivalentClass :receiverAgent ;
               rdfs:subClassOf <http://www.w3.org/ns/prov#Organization> ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :contactIdPid ;
                                 owl:minCardinality "1"^^xsd:nonNegativeInteger
                               ] ;
               rdfs:comment "a provenance structure that represents a receiver in the context of passing a described object between two provenance controllers."@en ;
               rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/cpm#> ;
               rdfs:label "ReceiverAgent"@en .


###  https://www.commonprovenancemodel.org/ns/cpm#SenderAgent
:SenderAgent rdf:type owl:Class ;
             owl:equivalentClass :senderAgent ;
             rdfs:subClassOf <http://www.w3.org/ns/prov#Organization> ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :contactIdPid ;
                               owl:minCardinality "1"^^xsd:nonNegativeInteger
                             ] ;
             rdfs:comment "a provenance structure that represents a sender in the context of passing a described object between two provenance controllers."@en ;
             rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/cpm#> ;
             rdfs:label "SenderAgent"@en .


###  https://www.commonprovenancemodel.org/ns/cpm#backwardConnector
:backwardConnector rdf:type owl:Class ;
                   <http://purl.org/vocab/vann/usageNote> "CPM type value used with prov:type in PROV-N/PROV-JSON/PROV-XML (prov:type='cpm:backwardConnector'). Declared as a class equivalent to cpm:BackwardConnector so that the rdf:type triple produced from prov:type by the PROV-O mapping is classified as cpm:BackwardConnector."@en ;
                   rdfs:comment "a connector that represents a received described object."@en ;
                   rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/cpm#> ;
                   rdfs:label "backwardConnector"@en .


###  https://www.commonprovenancemodel.org/ns/cpm#currentAgent
:currentAgent rdf:type owl:Class ;
              <http://purl.org/vocab/vann/usageNote> "CPM type value used with prov:type in PROV-N/PROV-JSON/PROV-XML (prov:type='cpm:currentAgent'). Declared as a class equivalent to cpm:CurrentAgent so that the rdf:type triple produced from prov:type by the PROV-O mapping is classified as cpm:CurrentAgent."@en ;
              rdfs:comment "a provenance structure that represents a provenance controller."@en ;
              rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/cpm#> ;
              rdfs:label "currentAgent"@en .


###  https://www.commonprovenancemodel.org/ns/cpm#forwardConnector
:forwardConnector rdf:type owl:Class ;
                  <http://purl.org/vocab/vann/usageNote> "CPM type value used with prov:type in PROV-N/PROV-JSON/PROV-XML (prov:type='cpm:forwardConnector'). Declared as a class equivalent to cpm:ForwardConnector so that the rdf:type triple produced from prov:type by the PROV-O mapping is classified as cpm:ForwardConnector."@en ;
                  rdfs:comment "a connector that represents a described object that can be sent from a sender to a receiver."@en ;
                  rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/cpm#> ;
                  rdfs:label "forwardConnector"@en .


###  https://www.commonprovenancemodel.org/ns/cpm#id
:id rdf:type owl:Class ;
    <http://purl.org/vocab/vann/usageNote> "CPM type value used with prov:type in PROV-N/PROV-JSON/PROV-XML (prov:type='cpm:id'). Declared as a class equivalent to cpm:IdentifierEntity so that the rdf:type triple produced from prov:type by the PROV-O mapping is classified as cpm:IdentifierEntity."@en ;
    rdfs:comment "a provenance structure that represents an external identifier."@en ;
    rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/cpm#> ;
    rdfs:label "id"@en .


###  https://www.commonprovenancemodel.org/ns/cpm#mainActivity
:mainActivity rdf:type owl:Class ;
              <http://purl.org/vocab/vann/usageNote> "CPM type value used with prov:type in PROV-N/PROV-JSON/PROV-XML (prov:type='cpm:mainActivity'). Declared as a class equivalent to cpm:MainActivity so that the rdf:type triple produced from prov:type by the PROV-O mapping is classified as cpm:MainActivity."@en ;
              rdfs:comment "a provenance structure that represents the described activity documented in a particular provenance component."@en ;
              rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/cpm#> ;
              rdfs:label "mainActivity"@en .


###  https://www.commonprovenancemodel.org/ns/cpm#receiverAgent
:receiverAgent rdf:type owl:Class ;
               <http://purl.org/vocab/vann/usageNote> "CPM type value used with prov:type in PROV-N/PROV-JSON/PROV-XML (prov:type='cpm:receiverAgent'). Declared as a class equivalent to cpm:ReceiverAgent so that the rdf:type triple produced from prov:type by the PROV-O mapping is classified as cpm:ReceiverAgent."@en ;
               rdfs:comment "a provenance structure that represents a receiver in the context of passing a described object between two provenance controllers."@en ;
               rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/cpm#> ;
               rdfs:label "receiverAgent"@en .


###  https://www.commonprovenancemodel.org/ns/cpm#senderAgent
:senderAgent rdf:type owl:Class ;
             <http://purl.org/vocab/vann/usageNote> "CPM type value used with prov:type in PROV-N/PROV-JSON/PROV-XML (prov:type='cpm:senderAgent'). Declared as a class equivalent to cpm:SenderAgent so that the rdf:type triple produced from prov:type by the PROV-O mapping is classified as cpm:SenderAgent."@en ;
             rdfs:comment "a provenance structure that represents a sender in the context of passing a described object between two provenance controllers."@en ;
             rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/cpm#> ;
             rdfs:label "senderAgent"@en .


###  https://www.commonprovenancemodel.org/ns/cpm#specForwardConnector
:specForwardConnector rdf:type owl:Class ;
                      <http://purl.org/vocab/vann/usageNote> "CPM type value used with prov:type in PROV-N/PROV-JSON/PROV-XML (prov:type='cpm:specForwardConnector'). Declared as a class equivalent to cpm:ForwardConnectorSpecialized so that the rdf:type triple produced from prov:type by the PROV-O mapping is classified as cpm:ForwardConnectorSpecialized."@en ;
                      rdfs:comment "a connector that represents a described object that has been sent from a sender to a receiver."@en ;
