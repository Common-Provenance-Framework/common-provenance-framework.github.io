###  https://www.commonprovenancemodel.org/ns/pbm#Acquisition
:Acquisition rdf:type owl:Class ;
             owl:equivalentClass :acquisition ;
             rdfs:subClassOf <http://www.w3.org/ns/prov#Activity> ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <http://www.w3.org/ns/prov#endedAtTime> ;
                               owl:minCardinality "1"^^xsd:nonNegativeInteger
                             ] ;
             rdfs:comment "a provenance structure that represents the acquisition of a sample."@en ;
             rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/pbm#> ;
             rdfs:label "Acquisition"@en .


###  https://www.commonprovenancemodel.org/ns/pbm#Container
:Container rdf:type owl:Class ;
           owl:equivalentClass :container ;
           rdfs:subClassOf <http://www.w3.org/ns/prov#Collection> ;
           rdfs:comment "a provenance structure that represents a container."@en ;
           rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/pbm#> ;
           rdfs:label "Container"@en .


###  https://www.commonprovenancemodel.org/ns/pbm#Distribution
:Distribution rdf:type owl:Class ;
              owl:equivalentClass :distribution ;
              rdfs:subClassOf <http://www.w3.org/ns/prov#Activity> ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty <http://www.w3.org/ns/prov#startedAtTime> ;
                                owl:minCardinality "1"^^xsd:nonNegativeInteger
                              ] ;
              rdfs:comment "a provenance structure that represents the distribution or disposal of a sample."@en ;
              rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/pbm#> ;
              rdfs:label "Distribution"@en .


###  https://www.commonprovenancemodel.org/ns/pbm#Processing
:Processing rdf:type owl:Class ;
            owl:equivalentClass :processing ;
            rdfs:subClassOf <http://www.w3.org/ns/prov#Activity> ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty <http://www.w3.org/ns/prov#startedAtTime> ;
                              owl:minCardinality "1"^^xsd:nonNegativeInteger
                            ] ;
            rdfs:comment "a provenance structure that represents the processing of a sample."@en ;
            rdfs:isDefinedBy <https://www.commonprovenancemodel.org/ns/pbm#> ;
            rdfs:label "Processing"@en .


