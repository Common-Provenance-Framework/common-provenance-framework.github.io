}, {
  "@id" : "https://www.commonprovenancemodel.org/ns/pbm#",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/abstract" : [ {
    "@language" : "en",
    "@value" : "The Provenance of Biological Material Ontology (PBM-O) expresses the Provenance of Biological Material (PBM) structures using the OWL 2 Web Ontology Language. The PBM structures are specializations of the provenance structures defined in W3C PROV-DM and are used together with the Common Provenance Model (CPM) to represent the provenance of biological material, such as samples and the activities performed on them. PBM-O is an extension of PROV-O."
  } ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-09-25"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "PBM-O provides IRIs, labels, and definitions for the terms of the PBM structures, so that these terms can be referenced from provenance documents expressed in PROV-N, PROV-JSON, PROV-XML, or RDF. In this version the ontology serves primarily as a vocabulary: it declares the PBM classes and aligns them with PROV-O. The minimum cardinality restrictions it contains document mandatory properties of the PBM structures but, under the open-world semantics of OWL, they do not validate data. Constraints for checking conformance and further features are planned for future versions."
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "http://creativecommons.org/licenses/by/4.0/"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "Provenance of Biological Material Ontology (PBM-O)"
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "pbm"
  } ],
  "http://purl.org/vocab/vann/preferredNamespaceUri" : [ {
    "@value" : "https://www.commonprovenancemodel.org/ns/pbm#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Following PROV-O (Section 3.1), the PROV-DM attribute prov:type is expressed in RDF with rdf:type; PBM-O therefore does not declare prov:type. PROV-N, PROV-JSON, and PROV-XML keep prov:type unchanged, e.g. prov:type='pbm:sample'. Each PBM type value (e.g. pbm:sample) is declared as a class equivalent to the corresponding PBM-O class (e.g. pbm:Sample), so RDF produced from PROV-N/PROV-JSON by standard PROV tooling is classified correctly. New RDF should use the capitalized class names."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "https://www.commonprovenancemodel.org/ns/cpm#"
  }, {
    "@id" : "https://www.commonprovenancemodel.org/ontologies/known-issues/"
  } ],
  "http://www.w3.org/2002/07/owl#imports" : [ {
    "@id" : "http://www.w3.org/ns/prov-o-20130430"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "https://www.commonprovenancemodel.org/ns/pbm/1.0.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@language" : "en",
    "@value" : "1.0.0"
  } ]
