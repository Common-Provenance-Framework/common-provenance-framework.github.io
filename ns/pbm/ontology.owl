    <!-- https://www.commonprovenancemodel.org/ns/pbm#Acquisition -->


    <owl:Class rdf:about="https://www.commonprovenancemodel.org/ns/pbm#Acquisition">
        <owl:equivalentClass rdf:resource="https://www.commonprovenancemodel.org/ns/pbm#acquisition"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#endedAtTime"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">a provenance structure that represents the acquisition of a sample.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.commonprovenancemodel.org/ns/pbm#"/>
        <rdfs:label xml:lang="en">Acquisition</rdfs:label>
    </owl:Class>
    


